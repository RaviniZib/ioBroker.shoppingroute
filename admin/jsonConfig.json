              "width": "18%",
              "sort": true,
              "jsonData": "{\"markets\":${JSON.stringify(globalData.markets || [])}}"
            },
            {
              "type": "selectSendTo",
              "attr": "availableMarkets",
              "command": "getActiveMarkets",
              "defaultSendTo": "normalizeMarketSelection",
              "manual": false,
              "multiple": true,
              "noTranslation": true,
              "jsonData": "{\"markets\":${JSON.stringify(globalData.markets || [])},\"value\":${JSON.stringify(data.availableMarkets == null ? '' : data.availableMarkets)}}",
              "title": "ui.items.productstab.items.products.items.4.title",
              "width": "22%"
            }
          ],
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "onChange": {
            "calculateFunc": "(data.products || []).map(row => ({...row,availableMarkets:Array.isArray(row.availableMarkets)?row.availableMarkets.map(v=>typeof v==='string'?v.trim():'').filter(Boolean).join(','):String(row.availableMarkets || '')}))"
          }
        }
