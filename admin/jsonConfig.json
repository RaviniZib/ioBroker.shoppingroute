{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": {
        "en": "General",
        "de": "Allgemein"
      },
      "items": {
        "betaWarning": {
          "type": "staticText",
          "text": {
            "en": "BETA 0.2.0-beta.1. Start with Dry-Run enabled. ShoppingRoute never creates, deletes or completes Alexa list items; it only redistributes visible value texts across existing active IDs.",
            "de": "BETA 0.2.0-beta.1. Zuerst mit Dry-Run testen. ShoppingRoute legt niemals Alexa-Listeneinträge an, löscht keine und hakt keine ab; es verteilt ausschließlich sichtbare value-Texte auf vorhandene aktive IDs."
          }
        },
        "alexaInstance": {
          "type": "text",
          "label": {
            "en": "Alexa2 instance",
            "de": "Alexa2-Instanz"
          },
          "newLine": true
        },
        "dryRun": {
          "type": "checkbox",
          "label": {
            "en": "Dry run (do not write to Alexa)",
            "de": "Dry-Run (nichts zu Alexa schreiben)"
          },
          "newLine": true
        },
        "learningMode": {
          "type": "select",
          "label": {
            "en": "Unknown-product handling",
            "de": "Umgang mit unbekannten Artikeln"
          },
          "options": [
            {
              "value": "review",
              "label": {
                "en": "Review first",
                "de": "Erst prüfen"
              }
            },
            {
              "value": "automatic",
              "label": {
                "en": "Learn automatically",
                "de": "Automatisch lernen"
              }
            },
            {
              "value": "off",
              "label": {
                "en": "Do not learn",
                "de": "Nicht lernen"
              }
            }
          ],
          "newLine": true
        },
        "autoAliasSuggestions": {
          "type": "checkbox",
          "label": {
            "en": "Suggest aliases automatically",
            "de": "Aliase automatisch vorschlagen"
          }
        },
        "fallbackMarket": {
          "type": "selectSendTo",
          "command": "getMarkets",
          "manual": false,
          "noTranslation": true,
          "label": {
            "en": "Fallback market",
            "de": "Fallback-Markt"
          },
          "newLine": true
        },
        "priorityMarket": {
          "type": "selectSendTo",
          "command": "getMarketsOptional",
          "manual": false,
          "noTranslation": true,
          "label": {
            "en": "Priority market",
            "de": "Prioritätsmarkt"
          }
        },
        "temporaryMarketHelp": {
          "type": "staticText",
          "newLine": true,
          "text": {
            "en": "For a one-off shopping trip, write a market name to shoppingroute.0.control.temporaryPriorityMarket. It overrides list and global priority markets until control.clearTemporaryPriorityMarket is triggered.",
            "de": "Für einen einzelnen Einkauf kann unter shoppingroute.0.control.temporaryPriorityMarket vorübergehend ein Markt gesetzt werden. Er übersteuert Listen- und globalen Prioritätsmarkt, bis control.clearTemporaryPriorityMarket ausgelöst wird."
          }
        },
        "temporaryMarketState": {
          "type": "state",
          "oid": "control.temporaryPriorityMarket",
          "control": "select",
          "controlled": true,
          "label": {
            "en": "Temporary priority market",
            "de": "Temporärer Prioritätsmarkt"
          },
          "newLine": true
        },
        "clearTemporaryMarket": {
          "type": "setState",
          "id": "control.clearTemporaryPriorityMarket",
          "val": true,
          "ack": false,
          "label": {
            "en": "Clear temporary market",
            "de": "Temporären Markt löschen"
          },
          "variant": "outlined"
        },
        "debounceMs": {
          "type": "number",
          "label": {
            "en": "Collect list changes for (ms)",
            "de": "Listenänderungen sammeln für (ms)"
          },
          "min": 250,
          "max": 60000,
          "newLine": true
        },
        "writePauseMs": {
          "type": "number",
          "label": {
            "en": "Pause between Alexa value writes (ms)",
            "de": "Pause zwischen Alexa-value-Schreibzugriffen (ms)"
          },
          "min": 250,
          "max": 10000
        }
      }
    },
    "listsTab": {
      "type": "panel",
      "label": {
        "en": "Lists",
        "de": "Listen"
      },
      "items": {
        "listsHelp": {
          "type": "staticText",
          "text": {
            "en": "ShoppingRoute can manage several Alexa lists. Each list may have its own priority market. The Alexa app must use 'Oldest to newest' for every managed list.",
            "de": "ShoppingRoute kann mehrere Alexa-Listen verwalten. Jede Liste kann einen eigenen Prioritätsmarkt erhalten. In der Alexa-App muss jede verwaltete Liste auf „Älteste bis neueste“ stehen."
          }
        },
        "lists": {
          "type": "table",
          "label": {
            "en": "Managed Alexa lists",
            "de": "Verwaltete Alexa-Listen"
          },
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": {
                "en": "Active",
                "de": "Aktiv"
              },
              "width": "15%"
            },
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "List name",
                "de": "Listenname"
              },
              "width": "40%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "priorityMarket",
              "command": "getMarketsOptional",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "List priority market",
                "de": "Listen-Prioritätsmarkt"
              },
              "width": "45%",
              "sort": true
            }
          ]
        }
      }
    },
    "marketsTab": {
      "type": "panel",
      "label": {
        "en": "Markets",
        "de": "Märkte"
      },
      "items": {
        "marketsHelp": {
          "type": "staticText",
          "text": {
            "en": "Market order is the top sorting level. Aliases are comma-separated. Common variants for ALDI, LIDL, REWE and PENNY are additionally recognized automatically.",
            "de": "Die Marktreihenfolge ist die oberste Sortierebene. Aliase werden kommagetrennt angegeben. Häufige Varianten für ALDI, LIDL, REWE und PENNY werden zusätzlich automatisch erkannt."
          }
        },
        "markets": {
          "type": "table",
          "label": {
            "en": "Markets",
            "de": "Märkte / Hauptkategorien"
          },
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": {
                "en": "Active",
                "de": "Aktiv"
              },
              "width": "10%"
            },
            {
              "type": "number",
              "attr": "order",
              "title": {
                "en": "Order",
                "de": "Reihenfolge"
              },
              "width": "12%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "Market",
                "de": "Markt"
              },
              "width": "28%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "aliases",
              "title": {
                "en": "Aliases",
                "de": "Aliase"
              },
              "width": "50%"
            }
          ]
        }
      }
    },
    "productGroupsTab": {
      "type": "panel",
      "label": {
        "en": "Product groups",
        "de": "Produktgruppen"
      },
      "items": {
        "productGroupsHelp": {
          "type": "staticText",
          "text": {
            "en": "Central list for all product-group drop-downs. Drop-down values are alphabetically sorted.",
            "de": "Zentrale Liste für alle Produktgruppen-Pulldowns. Die Pulldown-Werte werden alphabetisch sortiert."
          }
        },
        "productGroups": {
          "type": "table",
          "label": {
            "en": "Product groups",
            "de": "Produktgruppen"
          },
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "100%",
              "sort": true
            }
          ]
        }
      }
    },
    "routesTab": {
      "type": "panel",
      "label": {
        "en": "Walking routes",
        "de": "Laufwege"
      },
      "items": {
        "routesHelp": {
          "type": "staticText",
          "text": {
            "en": "The row order within each market is the shopping route. Move rows with the table arrows (or drag them when supported by your Admin version). ShoppingRoute reindexes route numbers automatically after saving.",
            "de": "Die Zeilenreihenfolge innerhalb eines Marktes ist der Laufweg. Zeilen mit den Tabellenpfeilen verschieben (oder per Drag & Drop, wenn die Admin-Version dies unterstützt). ShoppingRoute nummeriert die Reihenfolge nach dem Speichern automatisch neu."
          }
        },
        "routes": {
          "type": "table",
          "label": {
            "en": "Market / product-group route",
            "de": "Markt-/Produktgruppen-Laufweg"
          },
          "items": [
            {
              "type": "selectSendTo",
              "attr": "market",
              "command": "getMarkets",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Market",
                "de": "Markt"
              },
              "width": "40%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "category",
              "command": "getProductGroups",
              "manual": false,
              "noTranslation": true,
              "default": "Sonstiges",
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "45%",
              "sort": true
            },
            {
              "type": "number",
              "attr": "order",
              "title": {
                "en": "Auto order",
                "de": "Auto-Reihenfolge"
              },
              "width": "15%"
            }
          ]
        }
      }
    },
    "productsTab": {
      "type": "panel",
      "label": {
        "en": "Products",
        "de": "Artikel"
      },
      "items": {
        "productsHelp": {
          "type": "staticText",
          "text": {
            "en": "Click Product, Product group or Default market headers to sort. The catalogue itself is stored alphabetically, so equal groups/markets stay alphabetic. Available markets are comma-separated; the default market is the preferred exception to global/list priorities.",
            "de": "Über die Spaltenköpfe Artikel, Produktgruppe oder Standardmarkt sortieren. Der Artikelstamm wird grundsätzlich alphabetisch gespeichert, dadurch bleiben gleiche Gruppen/Märkte innerhalb der Sortierung alphabetisch. Verfügbare Märkte werden kommagetrennt angegeben; der Standardmarkt ist die bevorzugte Ausnahme von globalen/Listen-Prioritäten."
          }
        },
        "products": {
          "type": "table",
          "label": {
            "en": "Product catalogue",
            "de": "Artikelstamm"
          },
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "Product",
                "de": "Artikel"
              },
              "width": "20%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "aliases",
              "title": {
                "en": "Aliases",
                "de": "Aliase"
              },
              "width": "20%"
            },
            {
              "type": "selectSendTo",
              "attr": "category",
              "command": "getProductGroups",
              "manual": false,
              "noTranslation": true,
              "default": "Sonstiges",
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "20%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "defaultMarket",
              "command": "getMarketsOptional",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Default market",
                "de": "Standardmarkt"
              },
              "width": "18%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "availableMarkets",
              "title": {
                "en": "Available markets",
                "de": "Verfügbare Märkte"
              },
              "width": "22%"
            }
          ]
        }
      }
    },
    "reviewTab": {
      "type": "panel",
      "label": {
        "en": "Review",
        "de": "Prüfliste"
      },
      "items": {
        "reviewHelp": {
          "type": "staticText",
          "text": {
            "en": "Unknown products appear here in review mode. Correct product, product group, default market or aliases, choose Accept or Ignore, then save. Accepted entries are moved into the product catalogue after restart.",
            "de": "Im Prüfmodus erscheinen unbekannte Artikel hier. Artikelname, Produktgruppe, Standardmarkt oder Aliase korrigieren, dann Übernehmen oder Ignorieren wählen und speichern. Übernommene Einträge wandern nach dem Neustart in den Artikelstamm."
          }
        },
        "reviewItems": {
          "type": "table",
          "label": {
            "en": "Unknown products",
            "de": "Unbekannte Artikel prüfen"
          },
          "items": [
            {
              "type": "text",
              "attr": "product",
              "title": {
                "en": "Product",
                "de": "Artikel"
              },
              "width": "18%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "text",
              "title": {
                "en": "Alexa text",
                "de": "Alexa-Text"
              },
              "width": "22%"
            },
            {
              "type": "selectSendTo",
              "attr": "category",
              "command": "getProductGroups",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "18%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "defaultMarket",
              "command": "getMarketsOptional",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Default market",
                "de": "Standardmarkt"
              },
              "width": "16%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "aliases",
              "title": {
                "en": "Aliases",
                "de": "Aliase"
              },
              "width": "14%"
            },
            {
              "type": "select",
              "attr": "action",
              "title": {
                "en": "Action",
                "de": "Aktion"
              },
              "width": "12%",
              "options": [
                {
                  "value": "pending",
                  "label": {
                    "en": "Pending",
                    "de": "Offen"
                  }
                },
                {
                  "value": "accept",
                  "label": {
                    "en": "Accept",
                    "de": "Übernehmen"
                  }
                },
                {
                  "value": "ignore",
                  "label": {
                    "en": "Ignore",
                    "de": "Ignorieren"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "apiTab": {
      "type": "panel",
      "label": {
        "en": "API protection",
        "de": "API-Schutz"
      },
      "items": {
        "apiHelp": {
          "type": "staticText",
          "text": {
            "en": "API Safe Mode limits Alexa write frequency, groups large sorts into batches and retries temporary write errors with exponential backoff. It protects against unnecessary bursts; it does not poll Amazon.",
            "de": "Der API-Schonmodus begrenzt Alexa-Schreibzugriffe, teilt große Sortierungen in Blöcke und wiederholt vorübergehende Schreibfehler mit wachsender Pause. Er schützt vor unnötigen Zugriffsspitzen; ShoppingRoute pollt Amazon nicht."
          }
        },
        "apiSafeMode": {
          "type": "checkbox",
          "label": {
            "en": "Enable API Safe Mode",
            "de": "API-Schonmodus aktivieren"
          },
          "newLine": true
        },
        "maxWritesPerMinute": {
          "type": "number",
          "label": {
            "en": "Maximum writes per minute",
            "de": "Maximale Schreibzugriffe pro Minute"
          },
          "min": 1,
          "max": 120
        },
        "batchSize": {
          "type": "number",
          "label": {
            "en": "Writes per batch",
            "de": "Schreibzugriffe pro Block"
          },
          "min": 1,
          "max": 100,
          "newLine": true
        },
        "batchPauseMs": {
          "type": "number",
          "label": {
            "en": "Pause between batches (ms)",
            "de": "Pause zwischen Blöcken (ms)"
          },
          "min": 0,
          "max": 60000
        },
        "maxWriteRetries": {
          "type": "number",
          "label": {
            "en": "Maximum retries",
            "de": "Maximale Wiederholungen"
          },
          "min": 0,
          "max": 5,
          "newLine": true
        },
        "retryBaseMs": {
          "type": "number",
          "label": {
            "en": "Retry base delay (ms)",
            "de": "Grundpause für Wiederholungen (ms)"
          },
          "min": 250,
          "max": 30000
        }
      }
    },
    "transferTab": {
      "type": "panel",
      "label": {
        "en": "Backup / Sharing",
        "de": "Sicherung / Teilen"
      },
      "items": {
        "backupHelp": {
          "type": "staticText",
          "text": {
            "en": "Configuration export is available in info.configExport. Paste an export into control.importConfigJson to restore it. Market-only profiles are in info.marketProfiles and can be imported through control.marketProfileImport. This allows store routes to be shared without sharing the adapter source code.",
            "de": "Die komplette Konfigurationssicherung steht in info.configExport. Zum Wiederherstellen den Export in control.importConfigJson schreiben. Einzelne Marktprofile stehen in info.marketProfiles und werden über control.marketProfileImport importiert. So können Laufwege geteilt werden, ohne den Adapter-Quellcode zu teilen."
          }
        },
        "refreshExport": {
          "type": "setState",
          "id": "control.exportConfig",
          "val": true,
          "ack": false,
          "label": {
            "en": "Refresh configuration export",
            "de": "Konfigurations-Export aktualisieren"
          },
          "variant": "outlined",
          "newLine": true
        },
        "configExportState": {
          "type": "state",
          "oid": "info.configExport",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Configuration export JSON",
            "de": "Konfigurations-Export JSON"
          },
          "newLine": true
        },
        "configImportState": {
          "type": "state",
          "oid": "control.importConfigJson",
          "control": "input",
          "controlled": true,
          "label": {
            "en": "Paste configuration JSON to import",
            "de": "Konfigurations-JSON zum Import einfügen"
          },
          "newLine": true
        },
        "marketProfilesState": {
          "type": "state",
          "oid": "info.marketProfiles",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Market profiles JSON",
            "de": "Marktprofile JSON"
          },
          "newLine": true
        },
        "marketProfileImportState": {
          "type": "state",
          "oid": "control.marketProfileImport",
          "control": "input",
          "controlled": true,
          "label": {
            "en": "Paste one market profile JSON",
            "de": "Ein Marktprofil-JSON zum Import einfügen"
          },
          "newLine": true
        }
      }
    },
    "diagnosticsTab": {
      "type": "panel",
      "label": {
        "en": "Diagnostics",
        "de": "Diagnose"
      },
      "items": {
        "versionInfo": {
          "type": "staticText",
          "text": {
            "en": "Version information is exposed through info.versionInstalled, info.versionBeta, info.updateAvailable and info.versionCheck. Note: ioBroker Admin may show 'not maintained' as the available version while ShoppingRoute is not yet in the official ioBroker repository; ShoppingRoute cannot override that generic Admin card itself.",
            "de": "Versionsinformationen stehen unter info.versionInstalled, info.versionBeta, info.updateAvailable und info.versionCheck. Hinweis: Solange ShoppingRoute noch nicht im offiziellen ioBroker-Repository geführt wird, kann ioBroker Admin bei „Verfügbare Version“ generisch „nicht gewartet“ anzeigen; diese Kartenanzeige kann der Adapter selbst nicht überschreiben."
          }
        },
        "previewHelp": {
          "type": "staticText",
          "newLine": true,
          "text": {
            "en": "Sort preview: info.preview and info.previewText show current and target order before writes. Statistics stay local in info.statistics. API counters are in info.traffic.",
            "de": "Sortiervorschau: info.preview und info.previewText zeigen aktuelle und geplante Reihenfolge vor Schreibzugriffen. Die Einkaufsstatistik bleibt lokal in info.statistics. API-Zähler stehen in info.traffic."
          }
        },
        "feedbackHelp": {
          "type": "staticText",
          "newLine": true,
          "text": {
            "en": "For beta feedback trigger control.refreshFeedbackReport and copy info.feedbackReport. Product names, list texts, aliases and the full configuration are intentionally omitted.",
            "de": "Für Beta-Feedback control.refreshFeedbackReport auslösen und info.feedbackReport kopieren. Produktnamen, Listentexte, Aliase und die vollständige Konfiguration werden absichtlich nicht aufgenommen."
          }
        },
        "compatibilityHelp": {
          "type": "staticText",
          "newLine": true,
          "text": {
            "en": "If info.writeCapability is unknown, run control.compatibilityTest once with at least one active item. source-ok or live-ok permits writes; known-bug/live-failed/unknown blocks them.",
            "de": "Wenn info.writeCapability auf unknown steht, control.compatibilityTest einmal mit mindestens einem aktiven Artikel ausführen. source-ok oder live-ok erlaubt Schreibzugriffe; known-bug/live-failed/unknown blockiert sie."
          }
        },
        "versionInstalledState": {
          "type": "state",
          "oid": "info.versionInstalled",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Installed version",
            "de": "Installierte Version"
          },
          "newLine": true
        },
        "versionBetaState": {
          "type": "state",
          "oid": "info.versionBeta",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Latest npm beta",
            "de": "Neueste npm-Beta"
          }
        },
        "updateState": {
          "type": "state",
          "oid": "info.updateAvailable",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Update available",
            "de": "Update verfügbar"
          }
        },
        "previewState": {
          "type": "state",
          "oid": "info.previewText",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Last sorting preview",
            "de": "Letzte Sortiervorschau"
          },
          "newLine": true
        },
        "refreshFeedback": {
          "type": "setState",
          "id": "control.refreshFeedbackReport",
          "val": true,
          "ack": false,
          "label": {
            "en": "Refresh feedback report",
            "de": "Feedbackbericht aktualisieren"
          },
          "variant": "outlined",
          "newLine": true
        },
        "feedbackState": {
          "type": "state",
          "oid": "info.feedbackReport",
          "control": "text",
          "controlled": false,
          "label": {
            "en": "Privacy-safe feedback report",
            "de": "Datenschutzfreundlicher Feedbackbericht"
          },
          "newLine": true
        }
      }
    }
  }
}
