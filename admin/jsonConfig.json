{
  "type": "tabs",
  "items": {
    "general": {
      "type": "panel",
      "label": {
        "en": "General",
        "de": "Allgemein"
      },
      "items": {
        "betaWarning": {
          "type": "staticText",
          "text": {
            "en": "BETA 0.2.0-beta.6. Start with Dry-Run enabled. ShoppingRoute never creates, deletes or completes Alexa list items; it only redistributes visible value texts across existing active IDs.",
            "de": "BETA 0.2.0-beta.6. Zuerst mit Dry-Run testen. ShoppingRoute legt niemals Alexa-Listeneinträge an, löscht keine und hakt keine ab; es verteilt ausschließlich sichtbare value-Texte auf vorhandene aktive IDs."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "alexaInstance": {
          "type": "instance",
          "adapter": "alexa2",
          "onlyEnabled": true,
          "label": {
            "en": "Alexa2 instance",
            "de": "Alexa2-Instanz"
          },
          "help": {
            "en": "Only installed and enabled Alexa2 instances are offered. After changing the instance, save once so the list dropdowns can be refreshed from that instance.",
            "de": "Es werden nur installierte und aktivierte Alexa2-Instanzen angeboten. Nach einem Wechsel einmal speichern, damit die Listen-Auswahl aus dieser Instanz neu geladen werden kann."
          },
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "dryRun": {
          "type": "checkbox",
          "label": {
            "en": "Dry run (do not write to Alexa)",
            "de": "Dry-Run (nichts zu Alexa schreiben)"
          },
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "learningMode": {
          "type": "select",
          "label": {
            "en": "Unknown-product handling",
            "de": "Umgang mit unbekannten Artikeln"
          },
          "options": [
            {
              "value": "review",
              "label": {
                "en": "Review first",
                "de": "Erst prüfen"
              }
            },
            {
              "value": "automatic",
              "label": {
                "en": "Learn automatically",
                "de": "Automatisch lernen"
              }
            },
            {
              "value": "off",
              "label": {
                "en": "Do not learn",
                "de": "Nicht lernen"
              }
            }
          ],
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "autoAliasSuggestions": {
          "type": "checkbox",
          "label": {
            "en": "Suggest aliases automatically",
            "de": "Aliase automatisch vorschlagen"
          },
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "fallbackMarket": {
          "type": "selectSendTo",
          "command": "getMarkets",
          "manual": false,
          "noTranslation": true,
          "label": {
            "en": "Fallback market",
            "de": "Fallback-Markt"
          },
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "priorityMarket": {
          "type": "selectSendTo",
          "command": "getMarketsOptional",
          "manual": false,
          "noTranslation": true,
          "label": {
            "en": "Default market for shopping",
            "de": "Standardmarkt für Einkäufe"
          },
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3,
          "help": {
            "en": "Used when an item has no explicit market and no product-specific default market.",
            "de": "Wird verwendet, wenn beim Artikel kein Markt genannt und für den Artikel kein eigener Standardmarkt hinterlegt ist."
          }
        },
        "temporaryMarketHelp": {
          "type": "staticText",
          "newLine": true,
          "text": {
            "en": "The market for the current shopping trip temporarily overrides list and global default markets. Select “— No market —” in the dropdown to return to the normal defaults.",
            "de": "Der Markt für den aktuellen Einkauf überschreibt vorübergehend Listen- und Standardmarkt. Zum Zurücksetzen im Pulldown „— Kein Markt —“ auswählen."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "temporaryMarketState": {
          "type": "state",
          "oid": "control.temporaryPriorityMarket",
          "control": "select",
          "controlled": true,
          "label": {
            "en": "Market for current shopping",
            "de": "Markt für aktuellen Einkauf"
          },
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 4
        },
        "debounceMs": {
          "type": "number",
          "label": {
            "en": "Collect list changes for (ms)",
            "de": "Listenänderungen sammeln für (ms)"
          },
          "min": 250,
          "max": 60000,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "writePauseMs": {
          "type": "number",
          "label": {
            "en": "Pause between Alexa value writes (ms)",
            "de": "Pause zwischen Alexa-value-Schreibzugriffen (ms)"
          },
          "min": 250,
          "max": 10000,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "apiDivider": {
          "type": "divider",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "apiSectionTitle": {
          "type": "staticText",
          "text": {
            "en": "API protection",
            "de": "API-Schutz"
          },
          "style": {
            "fontSize": "1.15rem",
            "fontWeight": "600",
            "marginTop": "8px"
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "apiHelp": {
          "type": "staticText",
          "text": {
            "en": "API Safe Mode limits Alexa write frequency, groups large sorts into batches and retries temporary write errors with exponential backoff. It protects against unnecessary bursts; it does not poll Amazon.",
            "de": "Der API-Schonmodus begrenzt Alexa-Schreibzugriffe, teilt große Sortierungen in Blöcke und wiederholt vorübergehende Schreibfehler mit wachsender Pause. Er schützt vor unnötigen Zugriffsspitzen; ShoppingRoute pollt Amazon nicht."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "apiSafeMode": {
          "type": "checkbox",
          "label": {
            "en": "Enable API Safe Mode",
            "de": "API-Schonmodus aktivieren"
          },
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "maxWritesPerMinute": {
          "type": "number",
          "label": {
            "en": "Maximum writes per minute",
            "de": "Maximale Schreibzugriffe pro Minute"
          },
          "min": 1,
          "max": 120,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "batchSize": {
          "type": "number",
          "label": {
            "en": "Writes per batch",
            "de": "Schreibzugriffe pro Block"
          },
          "min": 1,
          "max": 100,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "batchPauseMs": {
          "type": "number",
          "label": {
            "en": "Pause between batches (ms)",
            "de": "Pause zwischen Blöcken (ms)"
          },
          "min": 0,
          "max": 60000,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "maxWriteRetries": {
          "type": "number",
          "label": {
            "en": "Maximum retries",
            "de": "Maximale Wiederholungen"
          },
          "min": 0,
          "max": 5,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        },
        "retryBaseMs": {
          "type": "number",
          "label": {
            "en": "Retry base delay (ms)",
            "de": "Grundpause für Wiederholungen (ms)"
          },
          "min": 250,
          "max": 30000,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 3
        }
      }
    },
    "listsTab": {
      "type": "panel",
      "label": {
        "en": "Lists",
        "de": "Listen"
      },
      "items": {
        "listsHelp": {
          "type": "staticText",
          "text": {
            "en": "ShoppingRoute reads the available lists from the selected Alexa2 instance. After changing the Alexa2 instance, save once and reopen this page. Each list may have its own default market. The Alexa app must use 'Oldest to newest' for every managed list.",
            "de": "ShoppingRoute liest die verfügbaren Listen aus der gewählten Alexa2-Instanz. Nach einem Wechsel der Alexa2-Instanz einmal speichern und diese Seite neu öffnen. Jede Liste kann einen eigenen Standardmarkt erhalten. In der Alexa-App muss jede verwaltete Liste auf „Älteste bis neueste“ stehen."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "lists": {
          "type": "table",
          "label": {
            "en": "Managed Alexa lists",
            "de": "Verwaltete Alexa-Listen"
          },
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": {
                "en": "Active",
                "de": "Aktiv"
              },
              "width": "15%"
            },
            {
              "type": "selectSendTo",
              "attr": "name",
              "command": "getAlexaLists",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Alexa list",
                "de": "Alexa-Liste"
              },
              "width": "40%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "priorityMarket",
              "command": "getMarketsOptional",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Default market for this list",
                "de": "Standardmarkt dieser Liste"
              },
              "width": "45%",
              "sort": true
            }
          ]
        }
      }
    },
    "marketsTab": {
      "type": "panel",
      "label": {
        "en": "Markets",
        "de": "Märkte"
      },
      "items": {
        "marketsHelp": {
          "type": "staticText",
          "text": {
            "en": "Market order is the top sorting level. Aliases are comma-separated. Common variants for ALDI, LIDL, REWE and PENNY are additionally recognized automatically.",
            "de": "Die Marktreihenfolge ist die oberste Sortierebene. Aliase werden kommagetrennt angegeben. Häufige Varianten für ALDI, LIDL, REWE und PENNY werden zusätzlich automatisch erkannt."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "markets": {
          "type": "table",
          "label": {
            "en": "Markets",
            "de": "Märkte / Hauptkategorien"
          },
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": {
                "en": "Active",
                "de": "Aktiv"
              },
              "width": "10%"
            },
            {
              "type": "number",
              "attr": "order",
              "title": {
                "en": "Order",
                "de": "Reihenfolge"
              },
              "width": "12%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "Market",
                "de": "Markt"
              },
              "width": "28%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "aliases",
              "title": {
                "en": "Aliases",
                "de": "Aliase"
              },
              "width": "50%"
            }
          ]
        }
      }
    },
    "productGroupsTab": {
      "type": "panel",
      "label": {
        "en": "Product groups",
        "de": "Produktgruppen"
      },
      "items": {
        "productGroupsHelp": {
          "type": "staticText",
          "text": {
            "en": "Central list for all product-group drop-downs. Drop-down values are alphabetically sorted.",
            "de": "Zentrale Liste für alle Produktgruppen-Pulldowns. Die Pulldown-Werte werden alphabetisch sortiert."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "productGroups": {
          "type": "table",
          "label": {
            "en": "Product groups",
            "de": "Produktgruppen"
          },
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "100%",
              "sort": true
            }
          ]
        }
      }
    },
    "routesTab": {
      "type": "panel",
      "label": {
        "en": "Walking routes",
        "de": "Laufwege"
      },
      "items": {
        "routesHelp": {
          "type": "staticText",
          "text": {
            "de": "In der Spalte „Markt“ den Filter verwenden und dort den gewünschten Markt aus dem Pulldown auswählen. Dann werden nur die Produktgruppen dieses Marktes angezeigt. Die Zeilen mit ↑/↓ in die tatsächliche Laufreihenfolge bringen.",
            "en": "Use the filter in the “Market” column and select the desired market from the dropdown. Only that market’s product groups are then shown. Move the rows with ↑/↓ into the actual walking order."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "routes": {
          "type": "table",
          "label": {
            "en": "Walking route – filter by market",
            "de": "Laufweg – nach Markt filtern"
          },
          "items": [
            {
              "type": "selectSendTo",
              "attr": "market",
              "command": "getMarkets",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Market",
                "de": "Markt"
              },
              "width": "40%",
              "sort": true,
              "filter": true
            },
            {
              "type": "selectSendTo",
              "attr": "category",
              "command": "getProductGroups",
              "manual": false,
              "noTranslation": true,
              "default": "Sonstiges",
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "45%",
              "sort": false
            },
            {
              "type": "number",
              "attr": "order",
              "title": {
                "en": "Auto order",
                "de": "Auto-Reihenfolge"
              },
              "width": "15%"
            }
          ],
          "allowAddByFilter": true,
          "compact": true
        }
      }
    },
    "productsTab": {
      "type": "panel",
      "label": {
        "en": "Products",
        "de": "Artikel"
      },
      "items": {
        "productsHelp": {
          "type": "staticText",
          "text": {
            "en": "Click Product, Product group or Default market headers to sort. The catalogue itself is stored alphabetically, so equal groups/markets stay alphabetic. Available markets are comma-separated; the default market is the preferred exception to global/list priorities.",
            "de": "Über die Spaltenköpfe Artikel, Produktgruppe oder Standardmarkt sortieren. Der Artikelstamm wird grundsätzlich alphabetisch gespeichert, dadurch bleiben gleiche Gruppen/Märkte innerhalb der Sortierung alphabetisch. Verfügbare Märkte werden kommagetrennt angegeben; der Standardmarkt ist die bevorzugte Ausnahme von globalen/Listen-Prioritäten."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "products": {
          "type": "table",
          "label": {
            "en": "Product catalogue",
            "de": "Artikelstamm"
          },
          "items": [
            {
              "type": "text",
              "attr": "name",
              "title": {
                "en": "Product",
                "de": "Artikel"
              },
              "width": "20%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "aliases",
              "title": {
                "en": "Aliases",
                "de": "Aliase"
              },
              "width": "20%"
            },
            {
              "type": "selectSendTo",
              "attr": "category",
              "command": "getProductGroups",
              "manual": false,
              "noTranslation": true,
              "default": "Sonstiges",
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "20%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "defaultMarket",
              "command": "getMarketsOptional",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Default market",
                "de": "Standardmarkt"
              },
              "width": "18%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "availableMarkets",
              "title": {
                "en": "Available markets",
                "de": "Verfügbare Märkte"
              },
              "width": "22%"
            }
          ]
        }
      }
    },
    "reviewTab": {
      "type": "panel",
      "label": {
        "en": "Review",
        "de": "Prüfliste"
      },
      "items": {
        "reviewHelp": {
          "type": "staticText",
          "text": {
            "en": "Unknown products appear here in review mode. Correct product, product group, default market or aliases, choose Accept or Ignore, then save. Accepted entries are moved into the product catalogue after restart.",
            "de": "Im Prüfmodus erscheinen unbekannte Artikel hier. Artikelname, Produktgruppe, Standardmarkt oder Aliase korrigieren, dann Übernehmen oder Ignorieren wählen und speichern. Übernommene Einträge wandern nach dem Neustart in den Artikelstamm."
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "reviewItems": {
          "type": "table",
          "label": {
            "en": "Unknown products",
            "de": "Unbekannte Artikel prüfen"
          },
          "items": [
            {
              "type": "text",
              "attr": "product",
              "title": {
                "en": "Product",
                "de": "Artikel"
              },
              "width": "18%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "text",
              "title": {
                "en": "Alexa text",
                "de": "Alexa-Text"
              },
              "width": "22%"
            },
            {
              "type": "selectSendTo",
              "attr": "category",
              "command": "getProductGroups",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Product group",
                "de": "Produktgruppe"
              },
              "width": "18%",
              "sort": true
            },
            {
              "type": "selectSendTo",
              "attr": "defaultMarket",
              "command": "getMarketsOptional",
              "manual": false,
              "noTranslation": true,
              "title": {
                "en": "Default market",
                "de": "Standardmarkt"
              },
              "width": "16%",
              "sort": true
            },
            {
              "type": "text",
              "attr": "aliases",
              "title": {
                "en": "Aliases",
                "de": "Aliase"
              },
              "width": "14%"
            },
            {
              "type": "select",
              "attr": "action",
              "title": {
                "en": "Action",
                "de": "Aktion"
              },
              "width": "12%",
              "options": [
                {
                  "value": "pending",
                  "label": {
                    "en": "Pending",
                    "de": "Offen"
                  }
                },
                {
                  "value": "accept",
                  "label": {
                    "en": "Accept",
                    "de": "Übernehmen"
                  }
                },
                {
                  "value": "ignore",
                  "label": {
                    "en": "Ignore",
                    "de": "Ignorieren"
                  }
                }
              ]
            }
          ]
        }
