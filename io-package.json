    "titleLang": {
      "en": "ShoppingRoute",
      "de": "ShoppingRoute"
    },
    "desc": {
      "en": "Smart Alexa shopping-list routing by market, product group and individual store walking route. Includes learning, review queue, multi-list support and API protection.",
      "de": "Intelligente Alexa-Einkaufslisten nach Markt, Produktgruppe und individuellem Laufweg sortieren – mit Lernfunktion, Prüfliste, mehreren Listen und API-Schutz."
    },
    "authors": [
      "RaviniZib"
    ],
    "keywords": [
      "alexa",
      "shopping",
      "shopping-list",
      "route",
      "grocery"
    ],
    "licenseInformation": {
      "type": "free",
      "license": "ShoppingRoute Closed Beta License 1.0"
    },
    "platform": "Javascript/Node.js",
    "main": "build/main.js",
    "mode": "daemon",
    "enabled": true,
    "compact": true,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=7.1.0"
      }
    ],
    "messagebox": true,
    "icon": "shoppingroute.png",
    "tier": 3,
    "news": {
      "0.2.0-beta.2": {
        "en": "Major beta expansion: review queue, improved parser, API safe mode, multiple lists, temporary market, product availability, statistics, config/profile transfer, version check and feedback report.",
