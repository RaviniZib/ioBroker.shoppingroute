{
  "name": "iobroker.shoppingroute",
  "version": "0.3.3",
  "description": "Smart Alexa shopping-list routing by market, product group and individual store walking route with learning, multi-list support and API protection.",
  "author": "RaviniZib",
  "license": "MIT",
  "homepage": "https://github.com/RaviniZib/ioBroker.shoppingroute",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaviniZib/ioBroker.shoppingroute.git"
  },
  "bugs": {
    "url": "https://github.com/RaviniZib/ioBroker.shoppingroute/issues"
  },
  "keywords": [
    "ioBroker",
    "iobroker",
    "alexa",
    "shopping",
    "shopping-list",
    "route",
    "grocery"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin",
    "build/**/*.js",
    "io-package.json",
    "LICENSE",
    "README.md",
    "README_DE.md"
  ],
  "scripts": {
    "build": "npm run build:admin && tsc -p tsconfig.json",
    "build:admin": "vite build && vite build --config vite.product-groups.config.mjs && vite build --config vite.markets.config.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "beta:package": "npm run build && node scripts/make-beta-package.js",
    "lint": "eslint src src-admin test scripts && npm run check",
    "prepublishOnly": "node scripts/block-root-publish.js",
    "test:integration": "mocha test/integration.js --exit",
    "test:package": "mocha test/package.js --exit",
    "stable:build": "npm run build && node scripts/prepare-stable-build.js"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1"
  },
  "devDependencies": {
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@module-federation/vite": "1.4.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.15.0",
    "javascript-obfuscator": "^5.5.0",
    "react": "18.3.1",
    "typescript": "^5.8.3",
    "vite": "6.3.5",
    "vite-plugin-commonjs": "0.10.4"
  }
}
